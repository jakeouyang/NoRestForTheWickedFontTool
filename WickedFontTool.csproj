<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <ApplicationIcon Condition="Exists('Resources/game.ico')">Resources/game.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);third_party/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="third_party/AssetsTools.NET/AssetTools.NET/AssetsTools.NET.csproj" />
    <EmbeddedResource Include="Resources/game.ico" Condition="Exists('Resources/game.ico')" />
    <EmbeddedResource Include="Resources/classdata.tpk" />
  </ItemGroup>
</Project>
